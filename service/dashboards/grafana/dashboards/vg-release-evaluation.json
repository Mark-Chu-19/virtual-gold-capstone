        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vg_external_source_available{job=\"vg-external\",instance=~\"$external_instance\",source=\"host\"}",
          "legendFormat": "Host source",

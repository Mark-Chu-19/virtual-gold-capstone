{
 "uid": "vg-redactor",
 "title": "Virtual Gold: Redaction Service",
 "tags": [
  "virtual-gold"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "editable": false,
 "graphTooltip": 1,
 "panels": [
  {
   "id": 1,
   "title": "1. Request rate and status codes",
   "type": "timeseries",
   "description": "POST /v1/redactions requests per second, by HTTP status.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (status) (rate(vg_http_requests_total{route=\"/v1/redactions\"}[1m]))",
     "legendFormat": "{{status}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 2,
   "title": "2. Availability (2xx / (2xx + 5xx))",
   "type": "stat",
   "description": "4xx and 429 are excluded: they are caller errors. A degraded 200 counts as available.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(vg_http_requests_total{route=\"/v1/redactions\",status=~\"2..\"}[5m])) / (sum(rate(vg_http_requests_total{route=\"/v1/redactions\",status=~\"2..\"}[5m])) + (sum(rate(vg_http_requests_total{route=\"/v1/redactions\",status=~\"5..\"}[5m])) or vector(0)))",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.95
       },
       {
        "color": "green",
        "value": 0.99
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 5,
   "title": "5. Degraded rate and reasons",
   "type": "timeseries",
   "description": "Degraded responses per second by reason, and the share of successful requests that were degraded.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (reason) (rate(vg_degraded_total[1m]))",
     "legendFormat": "{{reason}}",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(vg_degraded_total[1m])) / sum(rate(vg_request_duration_seconds_count{route=\"redactions\",mode!=\"error\"}[1m]))",
     "legendFormat": "degraded share",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "fillOpacity": 15
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 3,
   "title": "3. End-to-end latency p50 / p95 / p99 (normal vs degraded)",
   "type": "timeseries",
   "description": "Successful requests only. Normal and degraded are reported separately.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le, mode) (rate(vg_request_duration_seconds_bucket{route=\"redactions\",mode!=\"error\"}[1m])))",
     "legendFormat": "p50 {{mode}}",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le, mode) (rate(vg_request_duration_seconds_bucket{route=\"redactions\",mode!=\"error\"}[1m])))",
     "legendFormat": "p95 {{mode}}",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.99, sum by (le, mode) (rate(vg_request_duration_seconds_bucket{route=\"redactions\",mode!=\"error\"}[1m])))",
     "legendFormat": "p99 {{mode}}",
     "refId": "C"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 4,
   "title": "4. Per-stage time (p95)",
   "type": "timeseries",
   "description": "95th percentile of time spent in each pipeline stage.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(vg_stage_duration_seconds_bucket[1m])))",
     "legendFormat": "{{stage}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 6,
   "title": "6. Model-call outcomes by prompt",
   "type": "timeseries",
   "description": "Detection and assessment prompts are tracked separately: ok, unavailable, timeout, unparseable.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (prompt, outcome) (rate(vg_model_calls_total[1m]))",
     "legendFormat": "{{prompt}} / {{outcome}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "cps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 7,
   "title": "7. Records and capacity",
   "type": "timeseries",
   "description": "Live request records against the capacity cap; removals by reason.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 6,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "vg_records_active",
     "legendFormat": "active",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "vg_records_capacity",
     "legendFormat": "capacity",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (reason) (increase(vg_records_removed_total[5m]))",
     "legendFormat": "removed (5m) {{reason}}",
     "refId": "C"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 8,
   "title": "8a. Service mode",
   "type": "stat",
   "description": "ready = model usable; degraded = model down, rules and Presidio only.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 16,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "vg_service_mode == 1",
     "legendFormat": "{{mode}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "mappings": [
      {
       "type": "value",
       "options": {
        "ready": {
         "color": "green"
        },
        "degraded": {
         "color": "orange"
        },
        "down": {
         "color": "red"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "textMode": "name",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 9,
   "title": "8b. Versions in use",
   "type": "table",
   "description": "Policy, model, prompt and context-store versions reported by the running service.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 20,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "vg_build_info",
     "instant": true,
     "range": false,
     "format": "table",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "options": {
    "showHeader": true
   },
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Value": true,
       "__name__": true,
       "job": true,
       "instance": true
      },
      "renameByName": {}
     }
    },
    {
     "id": "transpose",
     "options": {}
    }
   ]
  }
 ],
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 }
}
